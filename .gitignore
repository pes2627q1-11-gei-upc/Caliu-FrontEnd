# GitIgnore para Visual Studio y IntelliJ usando Flutter 3

# ==============================================================================
# Core de Flutter y Dart
# ==============================================================================
.dart_tool/
.packages
.pub-cache/
.pub/
build/
coverage/
*.log
*.dart_tool

# ==============================================================================
# Entornos y Secretos
# ==============================================================================
.env
.env.*
*.jks
*.keystore
key.properties

# ==============================================================================
# Entornos de Desarrollo (IDE)
# ==============================================================================
# IntelliJ IDEA / Android Studio
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ==============================================================================
# Android (Archivos nativos y de compilación local)
# ==============================================================================
**/android/.gradle/
**/android/app/build/
**/android/captures/
**/android/gradlew.bat
**/android/gradle-wrapper.jar
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# ==============================================================================
# iOS (Archivos nativos y dependencias de CocoaPods)
# ==============================================================================
**/ios/**/*.mode1v3
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*.xcuserstate
**/ios/.symlinks/
**/ios/Pods/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# ==============================================================================
# Sistemas Operativos
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
